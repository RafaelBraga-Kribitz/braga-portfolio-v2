---
// Home cover, Site specimen s02, after the UX pass of 22 Oct 2026: a
// spec-sheet rail on three columns (kicker, then place · focus), the body
// on nine: the name with its ink mark (drawn by CSS on .cover-name), the
// role as the page's h1, one sentence, and a ruled footer holding the
// contact pair, whose accent button is the cover's one accent (G-15).
// Below 768 the body comes first (layout.css). The block carries its own
// hairline and top padding: place it directly in <main>, not inside
// .section. On a page whose copy is an agent draft (`draft`, the German
// home) the in-build mark with the "Entwurf · Freigabe ausstehend" label
// sits as a .label line directly under the ruled footer (HANDOFF D-011,
// item 25: drafts show their status in the page).
import { site } from '../lib/site';
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import StatusMark from './StatusMark.astro';
import ContactActions from './ContactActions.astro';

interface Props {
  lang: Lang;
  /** Rail rows, e.g. [{ k: 'Based in', v: 'Greater Graz, Austria' }]. */
  spec: { k: string; v: string }[];
  kicker?: string;
  /** Lines of the role title; the specimen breaks after "Marketing". */
  titleLines?: string[];
  lead: string;
  /** Show the draft mark under the cover's footer. */
  draft?: boolean;
}

const { lang, spec, kicker, titleLines, lead, draft = false } = Astro.props;
const lines = titleLines ?? [site.role[lang]];
---
<section class="cover">
  <div class="cover-rail">
    <span class="label cover-index">{kicker ?? t(lang, 'cover.kicker')}</span>
    <dl>
      {spec.map((s) => <div><dt class="label">{s.k}</dt><dd>{s.v}</dd></div>)}
    </dl>
  </div>
  <div class="cover-body">
    <p class="label cover-name">{site.name}</p>
    <h1 class="display cover-role">{lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</h1>
    <p class="prose cover-lead">{lead}</p>
    <div class="cover-foot">
      <ContactActions lang={lang} />
    </div>
    {draft && <p class="label"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></p>}
  </div>
</section>
