---
// Home — Site pattern 02 (Cover) and 03 (Index): the title page, then the
// four doors as sections, each opened by a section heading (kicker 3 /
// claim 7 / forward link 2) and followed by its rows. UX pass, 22 Oct 2026:
// the listings carry no head row (four sections would repeat it) and no
// year column; each section spends its one accent on one thing (G-15).
//
//   Cover       Site specimen s02: the rail (Based in · Evidence), the name,
//               the role, one sentence, the contact pair (the accent).
//   01 Work     Site specimen s03: claim, prose and "All 5 projects" as the
//               specimen sets them; one row per project of the language,
//               by code (the projects collection: title, summary as the
//               sub line, domain, status).
//   02 Writing  the claim the Writing index shares; one sentence of prose
//               (Home.md, writing_prose); the writing collection.
//   04 About    claim and prose (Home.md), the forward link to the
//               profile, then one block instead of a row per About
//               heading: the contact line and the contact pair.
//   03 Tools    claim and prose (Home.md); the two benches
//               (src/lib/catalogue.ts, shared with the index).
//
// Rows come from src/lib/collections.ts, which the section indexes and the
// sitemap read too; while a collection is empty its section shows the
// heading without a listing. The copy is the vault's (website_vault/Site/);
// the Work and Writing claims are shared with the indexes. Language draft
// marks follow isDraftLang; German was reviewed on 1 Nov 2026.
import Base from '@/layouts/Base.astro';
import Cover from '@/components/Cover.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import ContactActions from '@/components/ContactActions.astro';
import { t, formatDate, isDraftLang, type Lang } from '@/lib/i18n';
import { route, workRoute, writingRoute } from '@/lib/routes';
import { LANGS, site } from '@/lib/site';
import { tools } from '@/lib/catalogue';
import { copyOf } from '@/lib/vault/copy.mjs';
import { projectsOf, writingOf, writingCode, listIndex, libraryOf, ESSAYS_CODE, NOTES_CODE, HOME_ESSAYS, LISTING_KEYWORDS } from '@/lib/collections';
import { homeGraph } from '@/lib/structured-data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// Every sentence of this page is a property of website_vault/Site/<lang>/
// Home.md (and Work.md, Writing.md for the claims the indexes share): the
// page holds no copy of its own (owner, 10 Nov 2026).
const home = copyOf('Home', lang);
const copy = {
  title: site.role[lang],
  lead: home.lead as string,
  seo: home.seo_description as string,
  titleLines: home.title_lines as string[],
  writing: { prose: home.writing_prose as string },
  about: { claim: home.about_claim as string, prose: home.about_prose as string, contact: home.contact as string },
  tools: { claim: home.tools_claim as string, prose: home.tools_prose as string },
};

const projects = await projectsOf(lang);
const writing = await writingOf(lang);
// the rail's evidence row: counts of the collections, never typed
const countOf = (n: number, one: string, many: string) => (n === 1 ? one : many.replace('{n}', String(n)));
const evidence = [
  projects.length > 0 && countOf(projects.length, t(lang, 'cover.n-projects-one'), t(lang, 'cover.n-projects')),
  writing.length > 0 && countOf(writing.length, t(lang, 'cover.n-essays-one'), t(lang, 'cover.n-essays')),
].filter(Boolean).join(' · ');
const spec = [
  { k: t(lang, 'cover.based-in'), v: site.location[lang] },
  ...(evidence ? [{ k: t(lang, 'cover.evidence'), v: evidence }] : []),
];
// the five newest essays, counted 01–05 in the column with the permanent
// code in the meta (owner, 1 Nov 2026), then Writing's two categories as
// rows in code order: 02-01 all essays, 02-02 the notes library (owner,
// 30 Oct 2026)
const latest = writing.slice(0, HOME_ESSAYS);
const library = (await libraryOf(lang)).length ? await libraryOf(lang) : await libraryOf('en');
const libraryCount = library.reduce((n, a) => n + a.rows.length, 0);
const allProjects = projects.length ? t(lang, 'all-n-projects').replace('{n}', String(projects.length)) : t(lang, 'all-projects');
---
<Base lang={lang} page="home" title={copy.title} description={copy.seo} structuredData={homeGraph(lang, copy.lead)}>
  <Cover lang={lang} spec={spec} titleLines={copy.titleLines} lead={copy.lead} draft={isDraftLang(lang)} forward={projects.length > 0 ? { href: '#work', label: t(lang, 'cover.projects').replace('{n}', String(projects.length)) } : undefined} />

  <section class="section" id="work">
    <SectionHeading number="01" word={t(lang, 'door.work')} claim={t(lang, 'work.claim')} prose={t(lang, 'work.prose')} link={{ href: route('work', lang), label: allProjects }} />
    {projects.length > 0 && (
      <Listing keys>
        {projects.map((p) => (
          <ListingRow code={p.data.code} title={p.data.title} sub={p.data.summary} meta={[p.data.domain]} status={p.data.status} keys={p.data.stack.slice(0, LISTING_KEYWORDS)} titleLevel={3} lang={lang} href={workRoute(p.data.slug, lang)} />
        ))}
      </Listing>
    )}
    <a class="label section-forward" href={route('work', lang)}>{allProjects} <span aria-hidden="true">→</span></a>
  </section>

  <section class="section" id="writing">
    <SectionHeading number="02" word={t(lang, 'door.writing')} claim={t(lang, 'writing.claim')} prose={copy.writing.prose} link={{ href: route('writing', lang), label: t(lang, 'all-writing') }} />
    {writing.length + libraryCount > 0 && (
      <Listing>
        {latest.map((e, i) => (
          <ListingRow code={listIndex(i)} title={e.data.title} sub={e.data.summary} meta={[writingCode(e, writing), t(lang, `kind.${e.data.kind}`), formatDate(e.data.date, lang)]} titleLevel={3} lang={lang} href={writingRoute(e.data.slug, lang)} />
        ))}
        {writing.length > 0 && (
          <ListingRow register code={ESSAYS_CODE} title={writing.length === 1 ? t(lang, 'all-n-essays-one') : t(lang, 'all-n-essays').replace('{n}', String(writing.length))} sub={t(lang, 'essays.sub')} meta={[t(lang, 'essays.word')]} lang={lang} href={`${route('writing', lang)}#essays`} />
        )}
        {libraryCount > 0 && (
          <ListingRow register code={NOTES_CODE} title={t(lang, 'notes.word')} sub={`${lang === 'de' ? 'Notizen auf Englisch · ' : ''}${library.map((a) => a.title).join(' · ')}`} meta={[t(lang, 'kind.library'), t(lang, 'notes.count').replace('{n}', String(libraryCount))]} lang={lang} href={route('notes', lang)} />
        )}
      </Listing>
    )}
    <a class="label section-forward" href={route('writing', lang)}>{t(lang, 'all-writing')} <span aria-hidden="true">→</span></a>
  </section>

  <section class="section" id="tools">
    <SectionHeading number="03" word={t(lang, 'door.tools')} claim={copy.tools.claim} prose={copy.tools.prose} link={{ href: route('tools', lang), label: t(lang, 'all-tools') }} />
    <Listing>
      {tools(lang).map((row) => (
        <ListingRow code={row.code} title={row.title} sub={row.sub} meta={[row.domain]} status={row.status} titleLevel={3} lang={lang} trail={t(lang, 'open')} href={route(row.page, lang)} />
      ))}
    </Listing>
    <a class="label section-forward" href={route('tools', lang)}>{t(lang, 'all-tools')} <span aria-hidden="true">→</span></a>
  </section>

  <section class="section" id="about">
    <SectionHeading number="04" word={t(lang, 'door.about')} claim={copy.about.claim} prose={copy.about.prose} link={{ href: route('about', lang), label: t(lang, 'open-profile') }} />
    <div class="grid">
      <div class="section-contact">
        <p class="prose">{copy.about.contact}</p>
        <ContactActions lang={lang} />
      </div>
    </div>
  </section>
</Base>
