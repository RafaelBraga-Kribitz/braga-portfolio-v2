---
// Metric strip, Site specimen s04: three figures between an ink rule and
// a hairline; the one earned figure takes the accent (one accent per section, `accent`).
// Inside article.doc the strip spans the wide track and the flow rules
// give metric strip → h2 its group gap.
interface Props {
  metrics: { value: string; label: string; accent?: boolean }[];
}

const { metrics } = Astro.props;
---
<div class="metric-strip">
  {metrics.map((m) => (
    <div class="metric" data-accent={m.accent === true ? true : undefined}>
      <div class="metric-value">{m.value}</div>
      <div class="metric-label label">{m.label}</div>
    </div>
  ))}
</div>
