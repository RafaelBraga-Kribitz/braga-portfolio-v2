---
// Site footer, Site specimen s01: four link groups (D-013) over a
// wordmark bar. The bar's right block is the specimen's three-line
// colophon: name / location · EUR / status · year. The status line states
// the status of this build (i18n `footer.status`) where the specimen says
// "Private review · copy awaiting approval"; the year is a plain figure
// (no © glyph: D-030). Casing is the stylesheet's (the colophon and
// labels are uppercased by CSS), so the source text keeps its natural case.
import { site } from '../lib/site';
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import { footerGroups } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = footerGroups(lang);
const year = new Date().getFullYear();
---
<footer class="grid-container">
  <div class="site-footer">
    <div class="grid">
      {groups.map((g) => (
        <nav class="col-3 site-footer-group" aria-label={g.title}>
          <p class="label">{g.title}</p>
          <ul class="site-footer-links">
            {g.links.map((l) => (
              <li><a href={l.href} hreflang={l.hreflang} lang={l.lang} data-keys-open={l.keys ? '' : undefined}>{l.label}{l.external && <Fragment> <span class="glyph" aria-hidden="true">↗</span></Fragment>}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="site-footer-bar">
      <span class="site-footer-mark">{site.wordmark}</span>
      <p class="site-footer-colophon">{site.name}<br>{site.location[lang]} · EUR<br>{t(lang, 'footer.status')} · {String(year)}</p>
    </div>
  </div>
</footer>
