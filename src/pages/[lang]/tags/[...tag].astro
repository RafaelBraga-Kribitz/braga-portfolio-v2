---
// A tag's page (owner, 23 Oct 2026; Ghost's tag archive): every published
// project, essay and note of the language that carries the tag, newest
// first, as the section indexes list them. Tags come from the vault: the
// `tags` property and inline #tags (#status/… and #draft are properties,
// not tags). A tag lives in one language; when the other language uses
// the same tag, the two pages are twins.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import { t, otherLang, formatDate, isDraftLang, type Lang } from '@/lib/i18n';
import StatusMark from '@/components/StatusMark.astro';
import { workRoute, writingRoute, withBase } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { projectsOf, writingOf, writingCode, tagPath } from '@/lib/collections';

export async function getStaticPaths() {
  const tagged = async (lang: Lang) => {
    const projects = await projectsOf(lang);
    const writing = await writingOf(lang);
    const rows = [
      ...projects.map((p) => ({ tags: p.data.tags, date: p.data.date, code: p.data.code, title: p.data.title, sub: p.data.summary, meta: [p.data.domain], status: p.data.status, href: workRoute(p.data.slug, lang) })),
      ...writing.map((e, i) => ({ tags: e.data.tags, date: e.data.date, code: writingCode(e, i), title: e.data.title, sub: e.data.summary, meta: [t(lang, `kind.${e.data.kind}`), formatDate(e.data.date, lang)], status: undefined, href: writingRoute(e.data.slug, lang) })),
    ];
    const byTag = new Map<string, typeof rows>();
    for (const r of rows) for (const tag of r.tags) byTag.set(tag, [...(byTag.get(tag) ?? []), r]);
    return byTag;
  };
  const all = Object.fromEntries(await Promise.all(LANGS.map(async (l) => [l, await tagged(l)] as const)));
  const paths = [];
  for (const lang of LANGS) {
    for (const [tag, rows] of all[lang]) {
      const twin = all[otherLang(lang)].has(tag) ? withBase(tagPath(tag, otherLang(lang))) : null;
      paths.push({ params: { lang, tag }, props: { tag, rows: rows.sort((a, b) => b.date.localeCompare(a.date)), twin } });
    }
  }
  return paths;
}

interface Row { code: string; title: string; sub: string; meta: string[]; status?: 'complete' | 'functional' | 'under-revision' | 'in-build' | 'archived'; href: string }
interface Props { tag: string; rows: Row[]; twin: string | null }

const lang = Astro.params.lang as Lang;
const { tag, rows, twin } = Astro.props;
const claim = t(lang, 'tags.claim').replace('{tag}', `#${tag}`);
---
<Base lang={lang} page="tags" path={withBase(tagPath(tag, lang))} twinPath={twin} title={`#${tag}`} description={claim}>
  <section class="section">
    <SectionHeading number="#" word={t(lang, 'tags.word')} claim={claim} prose={t(lang, 'tags.prose')} link={{ href: withBase(`/${lang}/tags/`), label: t(lang, 'tags.title') }} as="h1" />
    <Listing>
      {rows.map((r) => <ListingRow code={r.code} title={r.title} sub={r.sub} meta={r.meta} status={r.status} lang={lang} href={r.href} />)}
    </Listing>
    {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
