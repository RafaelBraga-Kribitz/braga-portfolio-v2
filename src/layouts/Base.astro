---
// Base layout: the contract of BUILD-BRIEF §9. Every page gets the head
// (the pre-paint theme script as its first script), the skip link, the
// shell, one <main id="main">, the footer, the inline theme toggle, and –
// only when hasCode — code.js. Nothing else runs on a content page. The
// inline shell script also runs (owner, 23 Oct 2026) the split contact
// button (src/components/ContactActions.astro, the mailto cta callout,
// src/lib/contact.mjs): it reveals the Copy and Open halves, reassembles
// the address from its reversed halves only on click, and acknowledges a
// copy at once; and the contents rail's active item: the h2 section in
// view gets aria-current="location" as the page scrolls.
//
// Theme (D-024). The two theme-color metas come before the pre-paint
// script so that it can reach them: with a stored choice it sets
// data-theme AND gives both metas the stored theme's colour (light is the
// first meta, dark the second), so the browser bar matches the page from
// the first paint, not only after a click. Their values and the script
// come from src/lib/theme.ts (read from tokens.css at build), shared with
// the root redirect page. The toggle reads the colour of the painted
// canvas (html is painted with --surface) after it flips the theme, so it
// never depends on what the pre-paint script overwrote; with no stored
// choice it follows the OS while the page is open (its aria-label names
// the theme in force).
//
// Share card and favicons (HANDOFF 24, AUDIT P-10): public/share-card.png
// and public/favicon-{32,180}.png, rendered by `npm run assets`
// (scripts/assets/build-assets.mjs). Every URL here goes through
// src/lib/routes.ts, so a project-page build (SITE_BASE) carries its base.
import '../styles/global.css';
import Shell from '../components/Shell.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import type { Lang } from '../lib/i18n';
import { t, otherLang } from '../lib/i18n';
import { route, alternates, absolute, withBase, type PageId, type DoorCode } from '../lib/routes';
import { themeColor, PREPAINT } from '../lib/theme';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  current?: DoorCode;
  hasCode?: boolean;
  noindex?: boolean;
  /** og:type: a document (project, essay) is an article. */
  ogType?: 'website' | 'article';
}

const { lang, page, title, description, current, hasCode = false, noindex = false, ogType = 'website' } = Astro.props;
const canonical = absolute(route(page, lang));
// The 404 has no German twin (one 404.html, English with the German
// line), so it declares no hreflang pair: an hreflang="de" pointing at
// an English page would be false.
const alts = page === 'notfound' ? [] : alternates(page);
const feed = absolute('/feed.xml');
const locale = { en: 'en_GB', de: 'de_AT' } as const;
const shareCard = absolute('/share-card.png');
const shareAlt = `${site.wordmark} · ${site.name} · ${site.role[lang]}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light}>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark}>
    <script is:inline set:html={PREPAINT}></script>
    <title>{title} · {site.name}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex">}
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')}>
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/favicon-180.png')}>
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:locale" content={locale[lang]}>
    <meta property="og:locale:alternate" content={locale[otherLang(lang)]}>
    <meta property="og:image" content={shareCard}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={shareAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={shareCard}>
    <meta name="twitter:image:alt" content={shareAlt}>
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · RSS`} href={feed}>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Shell lang={lang} page={page} current={current} />
    <main id="main" class="grid-container"><slot /></main>
    <Footer lang={lang} />
    <script is:inline>(function(){var d=document.documentElement;function rv(s){return (s||'').split('').reverse().join('')}function ad(n){return rv(n.getAttribute('data-u'))+'@'+rv(n.getAttribute('data-d'))}var ms=document.querySelectorAll('.mail-split');for(var i=0;i<ms.length;i++){ms[i].setAttribute('data-ready','');var hs=ms[i].querySelectorAll('[hidden]');for(var j=0;j<hs.length;j++)hs[j].hidden=false}document.addEventListener('click',function(e){var t=e.target;if(!t||!t.closest)return;var o=t.closest('.mail-split-open, a[data-mail]');if(o){var h=o.closest('[data-u]');if(!h)return;e.preventDefault();var s=h.getAttribute('data-subject');location.href='mailto:'+ad(h)+(s?'?subject='+encodeURIComponent(s):'');return}var c=t.closest('.mail-split-copy');if(!c)return;var m=c.closest('[data-u]');function done(ok){c.textContent=c.getAttribute(ok?'data-copied':'data-failed');clearTimeout(c._bk);c._bk=setTimeout(function(){c.textContent=c.getAttribute('data-label')},ok?2000:4000)}if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(ad(m)).then(function(){done(true)},function(){done(false)});else done(false)});var tl=document.querySelectorAll('nav.toc a[href^="#"]'),sec=[];for(var k=0;k<tl.length;k++){var el=document.getElementById(decodeURIComponent(tl[k].getAttribute('href').slice(1)));if(el)sec.push([el,tl[k]])}if(sec.length){var cur=null,tk=false;function spy(){tk=false;var y=(parseFloat(getComputedStyle(d).getPropertyValue('--shell-h'))||80)+48,a=null;for(var q=0;q<sec.length;q++){if(sec[q][0].getBoundingClientRect().top<=y)a=sec[q][1];else break}if(window.innerHeight+window.scrollY>=d.scrollHeight-2&&sec[sec.length-1][0].getBoundingClientRect().top<window.innerHeight)a=sec[sec.length-1][1];if(a!==cur){if(cur)cur.removeAttribute('aria-current');if(a)a.setAttribute('aria-current','location');cur=a}}addEventListener('scroll',function(){if(!tk){tk=true;requestAnimationFrame(spy)}},{passive:true});spy()}var b=document.querySelector('.shell-theme');if(!b)return;var ms=document.querySelectorAll('meta[name="theme-color"]');function current(){return d.dataset.theme||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}function label(theme){b.setAttribute('aria-label',b.getAttribute('data-label')+' · '+(theme==='dark'?b.getAttribute('data-dark'):b.getAttribute('data-light')))}label(current());try{window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){if(!d.dataset.theme)label(current())})}catch(e){}b.addEventListener('click',function(){var next=current()==='dark'?'light':'dark';d.dataset.theme=next;try{localStorage.setItem('bk-theme',next)}catch(e){}var c=getComputedStyle(d).backgroundColor;for(var i=0;i<ms.length;i++)ms[i].setAttribute('content',c);label(next)})})()</script>
    {hasCode && <script is:inline src={withBase('/scripts/code.js')} defer></script>}
  </body>
</html>
