---
// 02 · Writing index — Site pattern 03 (Index): the section heading (its
// claim is this page's h1; the prose is the note on the two registers,
// essays and notes, from home.yaml), then Writing's two categories, each a
// listing under its own head (owner, 30 Oct 2026): 02-01 Essays, every
// essay newest first, counted 01, 02, … in the column with its permanent
// code (02-01-008) in the meta beside the date (owner, 1 Nov 2026), and
// 02-02 Notes, the library as one row. The codes are stable references: a
// new essay never renumbers anything, and the column never counts
// backwards. The claim and the prose are i18n keys the home
// Index shares; the rows are the writing collection (src/lib/collections.ts).
// Language draft marks follow isDraftLang; document drafts are independent.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import StatusMark from '@/components/StatusMark.astro';
import { t, isDraftLang, formatDate, type Lang } from '@/lib/i18n';
import { route, writingRoute } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { writingOf, writingCode, listIndex, libraryOf, ESSAYS_CODE, NOTES_CODE } from '@/lib/collections';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const writing = await writingOf(lang);
// the notes library closes the writing listing as one row (owner, 25 Oct 2026)
const library = (await libraryOf(lang)).length ? await libraryOf(lang) : await libraryOf('en');
const libraryCount = library.reduce((n, a) => n + a.rows.length, 0);
---
<Base lang={lang} page="writing" title={t(lang, 'door.writing')} description={t(lang, 'writing.meta')} current="02">
  <section class="section">
    <SectionHeading number="02" word={t(lang, 'door.writing')} claim={t(lang, 'writing.claim')} prose={t(lang, 'writing.prose')} as="h1" />
    {writing.length > 0 && (
      <Listing id="essays" head={{ index: ESSAYS_CODE, title: t(lang, 'essays.word'), meta: t(lang, 'date'), trail: '' }}>
        {writing.map((e, i) => (
          <ListingRow code={listIndex(i)} title={e.data.title} sub={e.data.summary} meta={[writingCode(e, writing), formatDate(e.data.date, lang)]} titleLevel={2} lang={lang} href={writingRoute(e.data.slug, lang)} />
        ))}
      </Listing>
    )}
    {libraryCount > 0 && (
      <a id="notes" class="writing-forward" href={route('notes', lang)}><span class="lr-code">{NOTES_CODE}</span> {t(lang, 'notes.word')} · {t(lang, 'notes.count').replace('{n}', String(libraryCount))}{lang === 'de' && ' · auf Englisch'} <span aria-hidden="true">→</span></a>
    )}
    {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
