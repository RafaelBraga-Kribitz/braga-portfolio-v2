---
// Home — Site pattern 02 (Cover) and 03 (Index): the title page, then the
// four doors as sections, each opened by a section heading.
//   01 Work     the five projects (BUILD-BRIEF §4, notes from the Site
//               specimen's projects array)
//   02 Writing  the one essay (frontmatter of the source MDX)
//   03 About    the claim from about.yaml's lead
//   04 Tools    the two benches
// The rows live in src/lib/catalogue.ts so the indexes and the sitemap
// read the same list. German chrome and claims are agent drafts (O-05);
// on the home page the draft notice is an HTML comment only.
import Base from '@/layouts/Base.astro';
import Cover from '@/components/Cover.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import { t, formatDate, type Lang } from '@/lib/i18n';
import { route, workRoute, writingRoute } from '@/lib/routes';
import { LANGS, site } from '@/lib/site';
import { projects, essays, tools, toolsProse } from '@/lib/catalogue';
import { dash } from '@/lib/format.mjs';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    title: 'Marketing Data Analyst',
    lead: 'Marketing experience, translated into analytical work. Questions about demand, allocation and cost, answered with data and explicit limits.',
    titleLines: ['Marketing', 'Data Analyst'],
    focus: 'Marketing · Data · Decisions',
    edition: 'October 2026',
    work: {
      claim: 'A decision. Its evidence.',
      prose: 'Selected analytical projects, with the question, result and limits kept together.',
    },
    writing: {
      claim: 'Finished arguments and working notes.',
      // home.yaml sections[02].leadParagraphs[0], the em dash as the spaced en dash (O-03)
      prose: `Two registers, deliberately kept apart. Essays are finished arguments${dash('en')}a position taken, defended, and closed. Notes are the working surface, revised in place as the thinking moves.`,
    },
    about: {
      // about.yaml lead, second sentence (British "modelled"); the first
      // sentence with the role of D-001 (the source says "Scientist")
      claim: 'The domain knowledge comes from having run the campaigns, not just modelled them.',
      prose: 'Marketing Data Analyst, building the measurement and decision systems behind where marketing budget goes.',
    },
    tools: { claim: 'Change an assumption.' },
  },
  de: {
    title: 'Marketing Data Analyst',
    lead: 'Marketing-Erfahrung, übersetzt in analytische Arbeit. Fragen zu Nachfrage, Allokation und Kosten, beantwortet mit Daten und ausdrücklich genannten Grenzen.',
    titleLines: ['Marketing', 'Data Analyst'],
    focus: 'Marketing · Daten · Entscheidungen',
    edition: 'Oktober 2026',
    work: {
      claim: 'Eine Entscheidung. Ihre Belege.',
      prose: 'Ausgewählte analytische Projekte, bei denen Frage, Ergebnis und Grenzen beisammen bleiben.',
    },
    writing: {
      claim: 'Fertige Argumente und Arbeitsnotizen.',
      prose: `Zwei Register, bewusst getrennt. Essays sind fertige Argumente${dash('de')}eine Position, bezogen, verteidigt und abgeschlossen. Notizen sind die Arbeitsfläche, an Ort und Stelle überarbeitet, während das Denken sich bewegt.`,
    },
    about: {
      claim: 'Das Fachwissen stammt aus selbst geführten Kampagnen, nicht nur aus ihrer Modellierung.',
      prose: 'Marketing Data Analyst; baut die Mess- und Entscheidungssysteme hinter der Frage, wohin das Marketingbudget fließt.',
    },
    tools: { claim: 'Eine Annahme ändern.' },
  },
}[lang];

const spec = [
  { k: t(lang, 'cover.based-in'), v: site.location[lang] },
  { k: t(lang, 'cover.focus'), v: copy.focus },
  { k: t(lang, 'cover.edition'), v: copy.edition },
];
const textLang: Lang = 'en';
---
<Base lang={lang} page="home" title={copy.title} description={copy.lead}>
  {lang === 'de' && <Fragment set:html={'<!-- Entwurf · Freigabe ausstehend: German chrome and claims on this page are agent drafts awaiting the owner’s approval (HANDOFF O-05). -->'} />}
  <Cover lang={lang} spec={spec} titleLines={copy.titleLines} lead={copy.lead} />

  <section class="section" id="work">
    <SectionHeading number="01" word={t(lang, 'door.work')} claim={copy.work.claim} prose={copy.work.prose} link={{ href: route('work', lang), label: t(lang, 'all-5-projects') }} />
    <Listing head={{ index: t(lang, 'index'), title: t(lang, 'project'), meta: t(lang, 'discipline-status'), trail: t(lang, 'year') }}>
      {projects.map((p) => (
        <ListingRow code={p.code} title={p.title} sub={p.note} textLang={textLang} meta={[p.domain[lang]]} status={p.status} lang={lang} trail={p.year} href={workRoute(p.slug, lang)} />
      ))}
    </Listing>
  </section>

  <section class="section" id="writing">
    <SectionHeading number="02" word={t(lang, 'door.writing')} claim={copy.writing.claim} prose={copy.writing.prose} link={{ href: route('writing', lang), label: t(lang, 'all-writing') }} />
    <Listing head={{ index: t(lang, 'index'), title: t(lang, 'title'), meta: t(lang, 'kind-date'), trail: t(lang, 'year') }}>
      {essays.map((e) => (
        <ListingRow code={e.code} title={e.title} sub={e.summary} textLang={textLang} meta={[t(lang, `kind.${e.kind}`), formatDate(e.date, lang)]} lang={lang} trail={e.date.slice(0, 4)} href={writingRoute(e.slug, lang)} />
      ))}
    </Listing>
  </section>

  <section class="section" id="about">
    <SectionHeading number="03" word={t(lang, 'door.about')} claim={copy.about.claim} prose={copy.about.prose} link={{ href: route('about', lang), label: t(lang, 'open-profile') }} />
  </section>

  <section class="section" id="tools">
    <SectionHeading number="04" word={t(lang, 'door.tools')} claim={copy.tools.claim} prose={toolsProse(lang)} link={{ href: route('tools', lang), label: t(lang, 'all-tools') }} />
    <Listing head={{ index: t(lang, 'index'), title: t(lang, 'tool'), meta: t(lang, 'discipline-status'), trail: t(lang, 'open') }}>
      {tools(lang).map((row) => (
        <ListingRow code={row.code} title={row.title} sub={row.sub} meta={[row.domain]} status={row.status} lang={lang} trail={t(lang, 'open')} href={route(row.page, lang)} />
      ))}
    </Listing>
  </section>
</Base>
