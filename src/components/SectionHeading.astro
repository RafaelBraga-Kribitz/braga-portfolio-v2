---
// Section heading, Site specimen s03: opens on an ink rule; the number on
// column 1, the word and the claim from column 2, the forward link at the
// right (owner, 23 Oct 2026: the first level starts further out than the
// listing rows under it; layout.css section 5).
interface Props {
  number: string;
  word: string;
  claim: string;
  prose?: string;
  link?: { href: string; label: string };
  /** Heading level of the claim: h2 on a page with its own h1, h1 when
      the claim is the page's title (an index page). */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}

const { number, word, claim, prose, link, as, id } = Astro.props;
const Tag = as ?? 'h2';
---
<div class="section-heading" id={id}>
  <p class="label section-heading-kicker"><span>{number}</span><span>{word}</span></p>
  <div class="section-heading-claim">
    <Tag class="display">{claim}</Tag>
    {prose && <p class="prose">{prose}</p>}
  </div>
  {link && <a href={link.href} class="label section-heading-link">{link.label} <span class="glyph" aria-hidden="true">→</span></a>}
</div>
