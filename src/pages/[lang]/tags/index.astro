---
// The tag index (owner, 23 Oct 2026): every tag the language's published
// projects, essays and notes carry, with how many, most used first.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import { t, isDraftLang, type Lang } from '@/lib/i18n';
import StatusMark from '@/components/StatusMark.astro';
import { withBase } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { projectsOf, writingOf, tagPath } from '@/lib/collections';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const counts = new Map<string, number>();
for (const e of [...(await projectsOf(lang)), ...(await writingOf(lang))]) for (const tag of e.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const count = (n: number) => (n === 1 ? t(lang, 'tags.count-one') : t(lang, 'tags.count').replace('{n}', String(n)));
---
<Base lang={lang} page="tags" title={t(lang, 'tags.title')} description={t(lang, 'tags.index-claim')}>
  <section class="section">
    <SectionHeading number="#" word={t(lang, 'tags.title')} claim={t(lang, 'tags.index-claim')} as="h1" />
    {tags.length > 0 && (
      <Listing>
        {tags.map(([tag, n], i) => <ListingRow code={String(i + 1).padStart(2, '0')} title={`#${tag}`} meta={[count(n)]} lang={lang} href={withBase(tagPath(tag, lang))} />)}
      </Listing>
    )}
    {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
