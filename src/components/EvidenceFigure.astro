---
// Evidence figure, Site specimen s05: kicker, the finding as the heading,
// ink bars on a mid baseline, and a caption that gives n, scale and the
// mandatory source. Bar geometry is the one permitted inline form: the
// custom properties --x / --w on .ev-fill (BUILD-BRIEF §6 rule 1).
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Bar {
  label: string;
  /** The printed value, already formatted for the page language. */
  value: string;
  /** Left edge of the fill as a percentage of the track; default 0%. */
  x?: string;
  /** Width of the fill as a percentage of the track. */
  w: string;
  /** Draw the centre line (diverging bars around zero). */
  mid?: boolean;
  /** The one earned bar of a figure takes the accent (the figure's one accent, G-15). */
  accent?: boolean;
}

interface Props {
  lang: Lang;
  kicker: string;
  heading: string;
  bars: Bar[];
  caption: string;
  source: string;
  /** Twelve columns instead of six. */
  wide?: boolean;
  id?: string;
}

const { lang, kicker, heading, bars, caption, source, wide = false, id } = Astro.props;
const geometry = (b: Bar) => (b.x && b.x !== '0%' ? `--x: ${b.x}; --w: ${b.w}` : `--w: ${b.w}`);
---
<figure class:list={['evidence', wide ? 'col-12' : 'col-6']} id={id}>
  <p class="label">{kicker}</p>
  <p class="evidence-heading display">{heading}</p>
  <div class="ev-bars">
    {bars.map((b) => (
      <div class="ev-bar" data-accent={b.accent === true ? true : undefined}>
        <span class="ev-label">{b.label}</span>
        <span class="ev-track"><span class="ev-fill" style={geometry(b)}></span>{b.mid && <span class="ev-mid"></span>}</span>
        <span class="ev-value">{b.value}</span>
      </div>
    ))}
  </div>
  <figcaption>{caption}<br><b>{t(lang, 'source')}:</b> {source}</figcaption>
</figure>
