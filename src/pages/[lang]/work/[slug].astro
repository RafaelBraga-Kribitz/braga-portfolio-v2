---
// 01-NN · A project — the document template (docs/PAGE-BRIEF.md, Site
// specimen s04): the opener on the page grid (trail "01 Work → 01-04",
// title, lead, meta: domain · status · Published · reading time · Updated ·
// Repository ↗),
// then the contents rail on 3 and the document on 9: the metric strip from
// the frontmatter `metrics` (the accent one carries the accent), the
// Markdown body, the close (UX pass, 22 Oct 2026: the contact pair with
// the subject prefilled, then the repository link) and the end bar
// (← All projects · § END · next project by code, wrapping to the first). One page per language per entry of the
// projects collection; every word comes from the entry or from i18n.
import Document from '@/layouts/Document.astro';
import { render } from 'astro:content';
import { t, formatDate, type Lang } from '@/lib/i18n';
import { route, workRoute } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { otherLang } from '@/lib/i18n';
import { articleGraph } from '@/lib/structured-data';
import { projectsOf, nextOf, prevOf, readingMinutes, vaultExtras, type ProjectEntry } from '@/lib/collections';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const list = await projectsOf(lang);
    const others = await projectsOf(otherLang(lang));
    for (const entry of list) {
      const twin = others.find((o) => o.data.slug === entry.data.slug);
      paths.push({ params: { lang, slug: entry.data.slug }, props: { entry, list, twinPath: twin ? workRoute(twin.data.slug, twin.data.lang) : null } });
    }
  }
  return paths;
}

interface Props { entry: ProjectEntry; list: ProjectEntry[]; twinPath: string | null }

const { entry, list, twinPath } = Astro.props;
// the vault behind the note (owner, 23 Oct 2026): cover, tags, related notes
const extras = vaultExtras(entry, Astro.params.lang as Lang);
const lang = Astro.params.lang as Lang;
const d = entry.data;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const next = nextOf(list, entry);
const prev = prevOf(list, entry);

// the document as a schema.org Article by the Person (src/lib/structured-data.ts)
const structuredData = articleGraph(lang, { path: workRoute(d.slug, lang), title: d.seo_title ?? d.title, description: d.seo_description ?? d.summary, date: d.date, updated: d.updated, image: extras.cover?.src });

const meta = [
  { text: d.domain },
  { status: d.status },
  { text: `${t(lang, 'published')} ${formatDate(d.date, lang)}` },
  { text: t(lang, 'min-read').replace('{n}', String(readingMinutes(entry.body))) },
  ...(d.updated ? [{ text: `${t(lang, 'updated')} ${formatDate(d.updated, lang)}` }] : []),
  ...(d.repository ? [{ text: t(lang, 'repository'), href: d.repository, external: true }] : []),
];
---
<Document
  lang={lang}
  page={`work.${d.slug}`}
  title={d.title}
  description={d.summary}
  current="01"
  hasCode={remarkPluginFrontmatter?.hasCode === true}
  trail={[{ label: `01 ${t(lang, 'door.work')}`, href: route('work', lang) }, { label: d.code, current: true }]}
  lead={d.lead}
  meta={meta}
  draft={d.translationStatus === 'draft'}
  headings={headings}
  metrics={d.metrics}
  prev={{ href: route('work', lang), label: t(lang, 'all-projects') }}
  next={next && { href: workRoute(next.data.slug, lang), label: `${next.data.code} ${next.data.title}` }}
  nextDoc={next && workRoute(next.data.slug, lang)}
  twinPath={twinPath}
  seoTitle={d.seo_title}
  seoDescription={d.seo_description}
  canonicalUrl={d.canonical}
  cover={extras.cover}
  tags={extras.tags}
  related={extras.related}
  structuredData={structuredData}
  prevDoc={prev && workRoute(prev.data.slug, lang)}
  close={{ subject: t(lang, 'contact.subject').replace('{title}', `${d.code} ${d.title}`), repository: d.repository }}
>
  <Content />
</Document>
