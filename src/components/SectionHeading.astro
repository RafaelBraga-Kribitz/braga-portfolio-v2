---
// Section heading, Site specimen s03: opens on an ink rule; kicker
// (number · word) on three columns, claim on seven, forward link on two.
interface Props {
  number: string;
  word: string;
  claim: string;
  prose?: string;
  link?: { href: string; label: string };
  /** Heading level of the claim: h2 on a page with its own h1, h1 when
      the claim is the page's title (an index page). */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}

const { number, word, claim, prose, link, as, id } = Astro.props;
const Tag = as ?? 'h2';
---
<div class="section-heading" id={id}>
  <p class="col-3 label section-heading-kicker"><span>{number}</span><span>{word}</span></p>
  <div class="col-7 section-heading-claim">
    <Tag class="display">{claim}</Tag>
    {prose && <p class="prose">{prose}</p>}
  </div>
  {link && <a href={link.href} class="col-2 label section-heading-link">{link.label} <span class="glyph" aria-hidden="true">→</span></a>}
</div>
