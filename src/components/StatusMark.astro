---
// Status mark (D-029): one 7px square per state, drawn by CSS from
// data-state; the text label always sits beside it. `label` overrides the
// vocabulary label (the DE draft mark: in-build + "Entwurf · Freigabe
// ausstehend"). The draft mark also carries data-draft, which gate L-07
// looks for on every page of a draft language (DRAFT_LANGS, i18n.ts).
import type { Lang, StatusState } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  state: StatusState;
  lang: Lang;
  label?: string;
}

const { state, lang, label } = Astro.props;
const draft = state === 'in-build' && label !== undefined && label === t(lang, 'draft');
---
<span class="status" data-state={state} data-draft={draft ? '' : undefined}>{label ?? t(lang, `status.${state}`)}</span>
