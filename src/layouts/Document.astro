---
// The document template (docs/PAGE-BRIEF.md, Site specimen s04): projects,
// essays, About and the kitchen sink. Above the grid, the opener on the
// page grid (trail on 3; title, lead and meta on 9); then a 3/9 grid with
// the contents rail and the article:
//
//   <header class="doc-opener grid">…</header>
//   <div class="grid">
//
// With a portrait (About; owner, 24 Oct 2026) the two columns run on their
// own: the left (div.doc-side) holds the trail, the portrait and the
// contents rail; the article opens with the header (title, lead, meta), so
// the body follows the lead however tall the portrait is:
//
//   <div class="grid doc-split">
//     <div class="col-3 doc-side">trail · figure.portrait · nav.toc</div>
//     <article class="doc col-9"><header class="doc-opener">…</header> …</article>
//   </div>
//     <nav class="toc col-3">…</nav>
//     <article class="doc col-9">[metric strip] [details.toc-compact] <Content/>
//       [div.doc-close] <footer class="doc-end">…</footer></article>
//   </div>
//
// The contents rail lists the document's h2 sections in order (the numbers
// match the ones the stylesheet draws on each h2) and leaves out the
// footnotes heading (vault/_guide/Syntax reference.md §1). Without JavaScript there is
// no active item. The rail is omitted when the document has no h2.
//
// UX pass (22 Oct 2026): the rail is sticky from 768 up; below 768 it is
// hidden and the same list sits under the metric strip as a closed
// <details> (.toc-compact), so the figures and the summary come first.
// `close` ends a project on one primary action (the contact pair, subject
// prefilled) with the repository as a quiet link under it.
import Base from './Base.astro';
import DocOpener from '../components/DocOpener.astro';
import Toc from '../components/Toc.astro';
import MetricStrip from '../components/MetricStrip.astro';
import DocEnd from '../components/DocEnd.astro';
import ContactActions from '../components/ContactActions.astro';
import type { Lang, StatusState } from '../lib/i18n';
import { t } from '../lib/i18n';
import { withBase, type PageId, type DoorCode } from '../lib/routes';
import type { MarkdownHeading } from 'astro';

type Crumb = { label: string; href?: string; current?: boolean; sep?: '→' | '·' };
type MetaItem = { text: string; href?: string; external?: boolean } | { status: StatusState; label?: string };
type Link = { href: string; label: string };

interface Props {
  lang: Lang;
  page: PageId;
  /** <title> and og:title; the h1 is `heading` when given, else this. */
  title: string;
  heading?: string;
  description: string;
  current?: DoorCode;
  hasCode?: boolean;
  noindex?: boolean;
  trail: Crumb[];
  lead?: string;
  meta?: MetaItem[];
  /** The in-build mark with the draft label first in the meta row. */
  draft?: boolean;
  headings: MarkdownHeading[];
  metrics?: { value: string; label: string; accent?: boolean }[];
  /** End bar: the way back before the end mark, the next document after it; or `back` after it (utility style). */
  prev?: Link;
  next?: Link;
  back?: Link;
  /** Language of the document body when it differs from the page (a kitchen sink kept in English). */
  bodyLang?: Lang;
  /** The previous / next document's URL (the head's rel=prev/next: the p and n keys). */
  prevDoc?: string;
  nextDoc?: string;
  /** The other language's version: a path, null when there is none (a note in one language). */
  twinPath?: string | null;
  /** Ghost-style overrides (a note's seo_title, seo_description, canonical) and its cover image. */
  seoTitle?: string;
  seoDescription?: string;
  canonicalUrl?: string;
  cover?: { src: string; alt: string; width?: number; height?: number };
  /** The note's tags (links to their pages) and its related notes. */
  tags?: { label: string; href: string }[];
  related?: { href: string; title: string; sub?: string }[];
  /** A portrait in the opener's left column (About). */
  portrait?: { src?: string; alt: string; caption: string; empty: string };
  /** The close of a project: the mail subject and the repository link. */
  close?: { subject: string; repository?: string };
  /** schema.org nodes for the head (Base.astro, src/lib/structured-data.ts). */
  structuredData?: Record<string, unknown>[];
}

const {
  lang, page, title, heading, description, current, hasCode = false, noindex = false,
  trail, lead, meta = [], draft = false, headings, metrics = [], prev, next, back, bodyLang, close, portrait, prevDoc, nextDoc,
  twinPath, seoTitle, seoDescription, canonicalUrl, cover, tags = [], related = [], structuredData,
} = Astro.props;

const sections = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const toc = sections.map((h, i) => ({ n: String(i + 1).padStart(2, '0'), title: h.text, href: `#${h.slug}` }));
---
<Base lang={lang} page={page} title={title} description={description} current={current} hasCode={hasCode} noindex={noindex} ogType="article" prevDoc={prevDoc} nextDoc={nextDoc} twinPath={twinPath} seoTitle={seoTitle} seoDescription={seoDescription} canonicalUrl={canonicalUrl} ogImage={cover && { src: cover.src, alt: cover.alt }} structuredData={structuredData}>
  {!portrait && <DocOpener lang={lang} grid trail={trail} title={heading ?? title} lead={lead} meta={meta} draft={draft} />}
  <div class:list={['grid', portrait && 'doc-split']}>
    {portrait ? (
      <div class="col-3 doc-side">
        <DocOpener lang={lang} part="side" trail={trail} title={heading ?? title} portrait={portrait} />
        {toc.length > 0 && <Toc lang={lang} items={toc} />}
      </div>
    ) : toc.length > 0 && <Toc class="col-3" lang={lang} items={toc} />}
    <article class:list={['doc', 'col-9', !portrait && toc.length === 0 && 'col-start-4']} lang={bodyLang && bodyLang !== lang ? bodyLang : undefined}>
      {portrait && <DocOpener lang={lang} part="main" trail={trail} title={heading ?? title} lead={lead} meta={meta} draft={draft} />}
      {cover && (
        <figure class="media doc-cover"><img src={withBase(cover.src)} alt={cover.alt} width={cover.width} height={cover.height} decoding="async" /></figure>
      )}
      {metrics.length > 0 && <MetricStrip metrics={metrics} />}
      {toc.length > 0 && (
        <details class="toc toc-compact">
          <summary class="label">{t(lang, 'contents')}</summary>
          <ol>
            {toc.map((i) => <li><a href={i.href}><span class="toc-num">{i.n}</span><span>{i.title}</span></a></li>)}
          </ol>
        </details>
      )}
      <slot />
      {tags.length > 0 && (
        <p class="doc-tags">{tags.map((tg) => <a class="tag" href={withBase(tg.href)}>{tg.label}</a>)}</p>
      )}
      {related.length > 0 && (
        <section class="doc-related" aria-labelledby="doc-related-title">
          <p class="label" id="doc-related-title">{t(lang, 'related')}</p>
          {related.map((r) => (
            <div class="callout" data-callout="bookmark"><div class="callout-content"><a href={withBase(r.href)}><b>{r.title}</b>{r.sub && <span class="sub">{r.sub}</span>}<span class="glyph" aria-hidden="true">→</span></a></div></div>
          ))}
        </section>
      )}
      {close && (
        <div class="doc-close" lang={bodyLang && bodyLang !== lang ? lang : undefined}>
          <p>{t(lang, 'contact.project')}</p>
          <ContactActions lang={lang} subject={close.subject} />
          {close.repository && <p class="link-line"><a href={close.repository}>{t(lang, 'open-repository')} <span class="glyph" aria-hidden="true">↗</span></a></p>}
        </div>
      )}
      <DocEnd lang={lang} prev={prev} next={next} back={back} />
    </article>
  </div>
</Base>
