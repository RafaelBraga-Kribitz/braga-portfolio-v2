---
// 03-01 · Confusion matrix — Site pattern 06 (Bench). Opener on the page
// grid, the Preact island (default scenario server-rendered), then the
// no-script note, inside <noscript> (UX pass, 22 Oct 2026: a reader
// with JavaScript does not need it). Language drafts follow isDraftLang.
import Base from '@/layouts/Base.astro';
import DocOpener from '@/components/DocOpener.astro';
import Callout from '@/components/Callout.astro';
import ConfusionMatrixBench from '@/components/tools/ConfusionMatrixBench';
import { t, isDraftLang, type Lang } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { toolCopy } from '@/lib/catalogue';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// the page's words: website_vault/Site/<lang>/ (the tool's note; a soft
// hyphen in the German heading is written &shy; there)
const copy = toolCopy('tools.confusion-matrix', lang);
---
<Base lang={lang} page="tools.confusion-matrix" title={copy.title} description={copy.seo} current="03">
  <DocOpener
    lang={lang}
    grid
    trail={[{ label: `03 ${t(lang, 'door.tools')}`, href: route('tools', lang) }, { label: copy.code, current: true }]}
    title={copy.h1}
    lead={copy.lead}
    meta={copy.meta.map((text) => ({ text }))}
    draft={isDraftLang(lang)}
  />
  <div class="tool-body">
    <ConfusionMatrixBench client:load lang={lang} />
    <noscript><Callout type="tool"><p>{t(lang, 'tool.nojs')}</p></Callout></noscript>
  </div>
</Base>
