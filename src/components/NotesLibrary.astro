---
// The notes library (owner, 25–26 Oct 2026; Ghost style): the heading
// (02-02 Notes, h1) and the areas, each leading to its tag's archive, which
// lists that area's notes (02-02-NNN) 24 a page. The page lists areas only
// (owner, 30 Oct 2026): the notes themselves are one click further, under
// their area. The notes are written in English; the German pages keep them
// in English (textLang) under German chrome.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import TagChips from '@/components/TagChips.astro';
import { tagCatalogue } from '@/lib/tags';
import StatusMark from '@/components/StatusMark.astro';
import { t, isDraftLang, type Lang } from '@/lib/i18n';
import { route, withBase } from '@/lib/routes';
import { notesOf, libraryOf, tagPath, NOTES_CODE } from '@/lib/collections';

interface Props { lang: Lang }
const { lang } = Astro.props;

// a language without notes of its own shows the English library
const ownRows = await notesOf(lang);
const textLang: Lang = ownRows.length ? lang : 'en';
const rows = ownRows.length ? ownRows : await notesOf('en');
const areas = await libraryOf(textLang);
const catalogue = await tagCatalogue(lang);
const count = (n: number) => (n === 1 ? t(lang, 'notes.count-one') : t(lang, 'notes.count').replace('{n}', String(n)));
const meta = t(lang, 'notes.meta').replace('{n}', String(rows.length)).replace('{k}', String(areas.length));
const prose = t(lang, 'notes.prose').replace('{n}', String(rows.length)).replace('{k}', String(areas.length));
---
<Base lang={lang} page="notes" title={t(lang, 'notes.word')} description={meta} current="02">
  <section class="section">
    <SectionHeading number={NOTES_CODE} word={t(lang, 'notes.word')} claim={t(lang, 'notes.claim')} prose={prose} link={{ href: route('writing', lang), label: t(lang, 'all-writing') }} as="h1" />
    {areas.length > 0 && (
      <Listing head={{ index: t(lang, 'index'), title: t(lang, 'notes.areas'), meta: '', trail: '' }}>
        {areas.map((a) => (
          <Fragment>
            <ListingRow code={a.code} title={a.title} meta={[count(a.rows.length)]} lang={lang} textLang={textLang} href={withBase(tagPath(a.tag, textLang))} />
            <TagChips sub items={catalogue.byTag.get(a.tag)?.children ?? []} lang={lang} textLang={textLang} label={t(lang, 'tags.topics')} />
          </Fragment>
        ))}
      </Listing>
    )}
    {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
