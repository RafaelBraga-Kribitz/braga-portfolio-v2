---
// Listing wrapper, Site specimen s03: the head row names the four tab
// stops (index · title · meta · trail); rows come through the slot as
// <ListingRow>. The head is optional (UX pass, 22 Oct 2026): the section
// indexes keep it, the home page drops it, where four sections would
// repeat it.
interface Props {
  head?: { index: string; title: string; meta: string; trail: string };
  class?: string;
}

const { head, class: className } = Astro.props;
---
<div class:list={['listing', className]}>
  {head && <div class="listing-head"><span class="lr-index">{head.index}</span><span class="lr-title">{head.title}</span><span class="lr-meta">{head.meta}</span><span class="lr-trail">{head.trail}</span></div>}
  <slot />
</div>
