---
// Home — Site pattern 02 (Cover) and 03 (Index): the title page, then the
// four doors as sections, each opened by a section heading (kicker 3 /
// claim 7 / forward link 2) and followed by its rows. UX pass, 22 Oct 2026:
// the listings carry no head row (four sections would repeat it) and no
// year column; each section spends its one accent on one thing (G-15).
//
//   Cover       Site specimen s02: the rail (Based in · Focus), the name,
//               the role, one sentence, the contact pair (the accent).
//   01 Work     Site specimen s03: claim, prose and "All 5 projects" as the
//               specimen sets them; one row per project of the language,
//               by code (the projects collection: title, summary as the
//               sub line, domain, status).
//   02 Writing  the claim the Writing index shares (i18n); one sentence of
//               prose from home.yaml sections[02]; the writing collection.
//   04 About    claim and prose from home.yaml sections[03], the forward
//               link to the profile, then one block instead of a row per
//               About heading: the contact line (home.yaml's Contact
//               subNode) and the contact pair.
//   03 Tools    claim and prose from home.yaml sections[04]; the two
//               benches (src/lib/catalogue.ts, shared with the index).
//
// Rows come from src/lib/collections.ts, which the section indexes and the
// sitemap read too; while a collection is empty its section shows the
// heading without a listing. Home-only copy lives here; the Work and
// Writing claims are i18n keys shared with the indexes. German chrome and
// copy are agent drafts (O-05): the German cover shows the in-build mark
// with the "Entwurf · Freigabe ausstehend" label directly under its ruled
// footer (D-011, HANDOFF item 25), as a .label line.
import Base from '@/layouts/Base.astro';
import Cover from '@/components/Cover.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import ContactActions from '@/components/ContactActions.astro';
import { t, formatDate, isDraftLang, type Lang } from '@/lib/i18n';
import { route, workRoute, writingRoute } from '@/lib/routes';
import { LANGS, site } from '@/lib/site';
import { tools } from '@/lib/catalogue';
import { projectsOf, writingOf, writingCode, libraryOf } from '@/lib/collections';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// about.contact: home.yaml sections[03].subNodes, the Contact line, with
// the v2 role (D-001).
const copy = {
  en: {
    title: 'Marketing Data Analyst',
    lead: 'Marketing experience, translated into analytical work. Questions about demand, allocation and cost, answered with data and explicit limits.',
    titleLines: ['Marketing', 'Data Analyst'],
    focus: 'Marketing · Data · Decisions',
    writing: {
      prose: 'Two registers, deliberately kept apart; everything is dated, so nothing reads as more settled than it is.',
    },
    about: {
      claim: 'The work sits where a marketing decision meets the evidence for it.',
      prose: 'Most of it is measurement that has to survive a budget meeting, with the uncertainty carried through to the decision rather than rounded away.',
      contact: 'Email is the direct line, and it is answered. Worth writing about: a Marketing Data Analyst role, a measurement setup that looks misspecified, or a model whose numbers have stopped agreeing with the business.',
    },
    tools: {
      claim: 'Some arguments are easier to make with a control than with a paragraph.',
      prose: 'Small, self-contained instruments: nothing to install, no account, and no data leaving the browser.',
    },
  },
  de: {
    title: 'Marketing Data Analyst',
    lead: 'Marketing-Erfahrung, übersetzt in analytische Arbeit. Fragen zu Nachfrage, Allokation und Kosten, beantwortet mit Daten und ausdrücklich genannten Grenzen.',
    titleLines: ['Marketing', 'Data Analyst'],
    focus: 'Marketing · Daten · Entscheidungen',
    writing: {
      prose: 'Zwei Register, bewusst getrennt; alles ist datiert, damit nichts gefestigter wirkt, als es ist.',
    },
    about: {
      claim: 'Die Arbeit liegt dort, wo eine Marketingentscheidung auf ihre Belege trifft.',
      prose: 'Meist sind es Messungen, die eine Budgetbesprechung überstehen müssen, wobei die Unsicherheit bis zur Entscheidung mitgeführt statt weggerundet wird.',
      contact: 'E-Mail ist der direkte Weg, und sie wird beantwortet. Anlässe zum Schreiben: eine Rolle als Marketing Data Analyst, ein Messaufbau, der fehlspezifiziert wirkt, oder ein Modell, dessen Zahlen nicht mehr zum Geschäft passen.',
    },
    tools: {
      claim: 'Manche Argumente lassen sich mit einem Regler leichter führen als mit einem Absatz.',
      prose: 'Kleine, in sich geschlossene Instrumente: nichts zu installieren, kein Konto, keine Daten, die den Browser verlassen.',
    },
  },
}[lang];

const spec = [
  { k: t(lang, 'cover.based-in'), v: site.location[lang] },
  { k: t(lang, 'cover.focus'), v: copy.focus },
];
const projects = await projectsOf(lang);
const writing = await writingOf(lang);
// the notes library closes the writing listing as one row (owner, 25 Oct 2026)
const library = (await libraryOf(lang)).length ? await libraryOf(lang) : await libraryOf('en');
const libraryCount = library.reduce((n, a) => n + a.rows.length, 0);
const allProjects = projects.length ? t(lang, 'all-n-projects').replace('{n}', String(projects.length)) : t(lang, 'all-projects');
---
<Base lang={lang} page="home" title={copy.title} description={copy.lead}>
  <Cover lang={lang} spec={spec} titleLines={copy.titleLines} lead={copy.lead} draft={isDraftLang(lang)} />

  <section class="section" id="work">
    <SectionHeading number="01" word={t(lang, 'door.work')} claim={t(lang, 'work.claim')} prose={t(lang, 'work.prose')} link={{ href: route('work', lang), label: allProjects }} />
    {projects.length > 0 && (
      <Listing>
        {projects.map((p) => (
          <ListingRow code={p.data.code} title={p.data.title} sub={p.data.summary} meta={[p.data.domain]} status={p.data.status} lang={lang} href={workRoute(p.data.slug, lang)} />
        ))}
      </Listing>
    )}
  </section>

  <section class="section" id="writing">
    <SectionHeading number="02" word={t(lang, 'door.writing')} claim={t(lang, 'writing.claim')} prose={copy.writing.prose} link={{ href: route('writing', lang), label: t(lang, 'all-writing') }} />
    {writing.length + libraryCount > 0 && (
      <Listing>
        {writing.map((e, i) => (
          <ListingRow code={writingCode(e, i)} title={e.data.title} sub={e.data.summary} meta={[t(lang, `kind.${e.data.kind}`), formatDate(e.data.date, lang)]} lang={lang} href={writingRoute(e.data.slug, lang)} />
        ))}
        {libraryCount > 0 && (
          <ListingRow code={`02-${String(writing.length + 1).padStart(2, '0')}`} title={t(lang, 'notes.word')} sub={library.map((a) => a.title).join(' · ')} meta={[t(lang, 'kind.library'), t(lang, 'notes.count').replace('{n}', String(libraryCount))]} lang={lang} href={route('notes', lang)} />
        )}
      </Listing>
    )}
  </section>

  <section class="section" id="tools">
    <SectionHeading number="03" word={t(lang, 'door.tools')} claim={copy.tools.claim} prose={copy.tools.prose} link={{ href: route('tools', lang), label: t(lang, 'all-tools') }} />
    <Listing>
      {tools(lang).map((row) => (
        <ListingRow code={row.code} title={row.title} sub={row.sub} meta={[row.domain]} status={row.status} lang={lang} trail={t(lang, 'open')} href={route(row.page, lang)} />
      ))}
    </Listing>
  </section>

  <section class="section" id="about">
    <SectionHeading number="04" word={t(lang, 'door.about')} claim={copy.about.claim} prose={copy.about.prose} link={{ href: route('about', lang), label: t(lang, 'open-profile') }} />
    <div class="grid">
      <div class="section-contact">
        <p class="prose">{copy.about.contact}</p>
        <ContactActions lang={lang} />
      </div>
    </div>
  </section>
</Base>
