---
// The tag catalogue (owner, 1 Nov 2026; D-061): the tags by kind, each
// level small whatever the whole is. Until now the page was one list of
// every tag by count (186 rows, 33 screens on a phone); at ten times the
// content a list fails whatever its row height. So: a search box over
// tags and titles (progressive: /scripts/tags.js loads the index on the
// first keystroke; without it the box is not shown), the library as its
// seven areas with their topics as chips (the subtopics are on the area's
// and topic's archive pages), the hand tags of essays and projects and the
// stack keywords as chips, and one row to the A–Z (src/pages/[lang]/tags/
// all/), the complete flat index, partitioned by letter once it outgrows
// one page.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import TagChips from '@/components/TagChips.astro';
import TagSearch from '@/components/TagSearch.astro';
import { t, isDraftLang, type Lang } from '@/lib/i18n';
import StatusMark from '@/components/StatusMark.astro';
import { withBase } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { tagCatalogue } from '@/lib/tags';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const c = await tagCatalogue(lang);
const count = (n: number) => (n === 1 ? t(lang, 'tags.count-one') : t(lang, 'tags.count').replace('{n}', String(n)));
const prose = t(lang, 'tags.index-prose').replace('{n}', String(c.all.length)).replace('{m}', String(c.entries));
const azHref = withBase(`/${lang}/tags/all/`);
---
<Base lang={lang} page="tags" title={t(lang, 'tags.title')} description={prose} hasSearch>
  <section class="section">
    <SectionHeading number="#" word={t(lang, 'tags.title')} claim={t(lang, 'tags.index-claim')} prose={prose} as="h1" link={{ href: azHref, label: t(lang, 'tags.all-n').replace('{n}', String(c.all.length)) }} />
    <TagSearch lang={lang} />
    {c.areas.length > 0 && (
      <Listing class="lr-compact lr-wide" id="library" head={{ index: t(lang, 'index'), title: t(lang, 'tags.library'), meta: '', trail: '' }}>
        {c.areas.map((a) => (
          <Fragment>
            <ListingRow code={a.code ?? ''} title={a.name} meta={[count(a.count)]} lang={lang} textLang={c.libraryLang} href={withBase(a.href)} />
            {a.children.length > 0 && <TagChips items={a.children} lang={lang} textLang={c.libraryLang} sub />}
          </Fragment>
        ))}
      </Listing>
    )}
    {c.hand.length > 0 && (
      <Listing class="lr-compact lr-wide" id="hand" head={{ index: '#', title: t(lang, 'tags.hand'), meta: '', trail: '' }}>
        <TagChips items={c.hand} lang={lang} sub />
      </Listing>
    )}
    {c.stack.length > 0 && (
      <Listing class="lr-compact lr-wide" id="stack" head={{ index: '#', title: t(lang, 'tags.stack'), meta: '', trail: '' }}>
        <TagChips items={c.stack} lang={lang} sub />
      </Listing>
    )}
    <Listing class="lr-compact lr-wide" id="az">
      <ListingRow code="A–Z" title={t(lang, 'tags.all-n').replace('{n}', String(c.all.length))} sub={t(lang, 'tags.az-claim')} lang={lang} href={azHref} />
    </Listing>
    {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
