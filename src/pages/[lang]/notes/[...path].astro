---
// 02 · The notes library below its first level (owner, 26 Oct 2026). One
// route for two kinds of page:
//
//   a folder   /<lang>/notes/<area>/[<topic>/[<subtopic>/]][<page>/]
//              Site pattern 03 (Index): the heading (the folder's code and
//              title, h1; the parent as the forward link), then its
//              subfolders and notes, 12 rows a page, Pagination under the
//              listing (page 1 at the folder's URL, page n at …/<n>/).
//   a note     /<lang>/notes/<slug>/ — the document template as the essays
//              use it: the trail 02 Writing → Notes → area → topic →
//              subtopic → the note's code; the end bar leads to the next
//              note in reading order, wrapping to the first.
//
// Folder segments are the folder titles, kebab-cased; a note slug
// equal to an area's segment would take its URL, so the build stops on one.
import Base from '@/layouts/Base.astro';
import Document from '@/layouts/Document.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import Pagination from '@/components/Pagination.astro';
import StatusMark from '@/components/StatusMark.astro';
import { render } from 'astro:content';
import { t, formatDate, otherLang, isDraftLang, type Lang } from '@/lib/i18n';
import { route, noteRoute, notesFolderRoute, withBase } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { notesTree, noteNodes, noteRows, nextOf, prevOf, readingMinutes, vaultExtras, NOTES_PAGE_SIZE, type NoteNode, type NoteRow } from '@/lib/collections';

type Item = { code: string; title: string; sub?: string; count?: number; href: string };
type FolderProps = { kind: 'folder'; node: NoteNode; page: number; pages: number; items: Item[]; textLang: Lang };
type NoteProps = { kind: 'note'; row: NoteRow & { id: string }; rows: (NoteRow & { id: string })[]; twinPath: string | null };

export async function getStaticPaths() {
  const paths = [];
  const english = await notesTree('en');
  for (const lang of LANGS) {
    const own = await notesTree(lang);
    const root = own.count ? own : english;
    const textLang: Lang = own.count ? lang : 'en';
    // folders: every level below the root, paginated
    for (const node of noteNodes(root).slice(1)) {
      const items: Item[] = [
        ...node.children.map((c) => ({ code: c.code, title: c.title, sub: c.children.map((g) => g.title).join(' · ') || undefined, count: c.count, href: notesFolderRoute(c.segs, lang) })),
        ...node.notes.map((r) => ({ code: r.code, title: r.entry.data.title, href: noteRoute(r.entry.data.slug, r.entry.data.lang) })),
      ];
      const pages = Math.max(1, Math.ceil(items.length / NOTES_PAGE_SIZE));
      for (let page = 1; page <= pages; page++) {
        paths.push({
          params: { lang, path: [...node.segs, ...(page > 1 ? [String(page)] : [])].join('/') },
          props: { kind: 'folder', node, page, pages, items: items.slice((page - 1) * NOTES_PAGE_SIZE, page * NOTES_PAGE_SIZE), textLang } satisfies FolderProps,
        });
      }
    }
    // notes: only in the language they are written in
    if (!own.count) continue;
    const areaSegs = new Set(own.children.map((a) => a.segs[0]));
    const rows = noteRows(own).map((r) => ({ ...r, id: r.entry.id }));
    const others = noteRows(await notesTree(otherLang(lang)));
    for (const row of rows) {
      const slug = row.entry.data.slug;
      if (areaSegs.has(slug)) throw new Error(`notes: the note ${row.entry.id} has the slug "${slug}", the URL of a library area; give it another slug`);
      const twin = others.find((o) => o.entry.data.slug === slug);
      paths.push({ params: { lang, path: slug }, props: { kind: 'note', row, rows, twinPath: twin ? noteRoute(slug, twin.entry.data.lang) : null } satisfies NoteProps });
    }
  }
  return paths;
}

type Props = FolderProps | NoteProps;
const props = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const count = (n: number) => (n === 1 ? t(lang, 'notes.count-one') : t(lang, 'notes.count').replace('{n}', String(n)));

// ---- a folder ----
let folder: (FolderProps & { prose: string; parentLink: { href: string; label: string }; path: string; title: string }) | null = null;
if (props.kind === 'folder') {
  const { node, page, pages } = props;
  const parent = node.parents[node.parents.length - 1];
  const prose = node.children.length
    ? t(lang, node.parents.length === 1 ? 'notes.area-prose' : 'notes.topic-prose')
        .replace('{n}', String(node.count)).replace('{k}', String(node.children.length)).replace('{topics}', node.children.map((c) => c.title).join(', '))
    : node.notes.length === 1 ? `${t(lang, 'notes.count-one')}.` : t(lang, 'notes.leaf-prose').replace('{n}', String(node.count));
  folder = {
    ...props,
    prose: pages > 1 ? `${prose} ${t(lang, 'notes.page').replace('{p}', String(page)).replace('{t}', String(pages))}.` : prose,
    parentLink: parent.segs.length ? { href: notesFolderRoute(parent.segs, lang), label: `${parent.code} ${parent.title}` } : { href: route('notes', lang), label: t(lang, 'all-notes') },
    path: notesFolderRoute(node.segs, lang, page),
    title: pages > 1 ? `${node.title} · ${t(lang, 'notes.page').replace('{p}', String(page)).replace('{t}', String(pages))}` : node.title,
  };
}

// ---- a note ----
let note: Awaited<ReturnType<typeof noteData>> | null = null;
async function noteData(p: NoteProps) {
  const { row, rows } = p;
  const d = row.entry.data;
  const { Content, headings, remarkPluginFrontmatter } = await render(row.entry);
  const chain = [...row.node.parents.slice(1), row.node];
  return {
    ...p, d, Content, headings, hasCode: remarkPluginFrontmatter?.hasCode === true,
    extras: vaultExtras(row.entry, lang),
    next: nextOf(rows, row), prev: prevOf(rows, row),
    trail: [
      { label: `02 ${t(lang, 'door.writing')}`, href: route('writing', lang) },
      { label: t(lang, 'notes.word'), href: route('notes', lang) },
      ...chain.map((n) => ({ label: `${n.code} ${n.title}`, href: notesFolderRoute(n.segs, lang) })),
      { label: row.code, current: true },
    ],
    meta: [
      { text: `${t(lang, 'published')} ${formatDate(d.date, lang)}` },
      { text: t(lang, 'min-read').replace('{n}', String(readingMinutes(row.entry.body))) },
      ...(d.updated ? [{ text: `${t(lang, 'updated')} ${formatDate(d.updated, lang)}` }] : []),
    ],
  };
}
if (props.kind === 'note') note = await noteData(props);
---
{folder && (
  <Base lang={lang} page="notes" path={folder.path} twinPath={withBase(folder.path.replace(`/${lang}/`, `/${otherLang(lang)}/`))} title={folder.title} description={folder.prose} current="02">
    <section class="section">
      <SectionHeading number={folder.node.code} word={t(lang, 'notes.word')} claim={folder.node.title} prose={folder.prose} link={folder.parentLink} as="h1" />
      <Listing class={folder.node.segs.length > 1 ? 'lr-long-code' : undefined} head={{ index: t(lang, 'index'), title: t(lang, 'title'), meta: '', trail: '' }}>
        {folder.items.map((it) => (
          <ListingRow code={it.code} title={it.title} sub={it.sub} meta={it.count !== undefined ? [count(it.count)] : [t(lang, 'kind.note')]} lang={lang} textLang={folder!.textLang} href={it.href} />
        ))}
      </Listing>
      <Pagination page={folder.page} total={folder.pages} href={(p) => notesFolderRoute(folder!.node.segs, lang, p)} labels={{ nav: t(lang, 'pagination.nav'), prev: t(lang, 'pagination.prev'), next: t(lang, 'pagination.next'), page: t(lang, 'pagination.page') }} />
      {isDraftLang(lang) && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
    </section>
  </Base>
)}
{note && (
  <Document
    lang={lang}
    page={`notes.${note.d.slug}`}
    title={note.d.title}
    description={note.d.summary}
    current="02"
    hasCode={note.hasCode}
    trail={note.trail}
    lead={note.d.lead}
    meta={note.meta}
    draft={note.d.translationStatus === 'draft'}
    headings={note.headings}
    prev={{ href: notesFolderRoute(note.row.node.segs, lang), label: `${note.row.node.code} ${note.row.node.title}` }}
    next={note.next && { href: noteRoute(note.next.entry.data.slug, lang), label: `${note.next.code} ${note.next.entry.data.title}` }}
    nextDoc={note.next && noteRoute(note.next.entry.data.slug, lang)}
    twinPath={note.twinPath}
    seoTitle={note.d.seo_title}
    seoDescription={note.d.seo_description}
    canonicalUrl={note.d.canonical}
    cover={note.extras.cover}
    tags={note.extras.tags}
    related={note.extras.related}
    prevDoc={note.prev && noteRoute(note.prev.entry.data.slug, lang)}
  >
    <note.Content />
  </Document>
)}
