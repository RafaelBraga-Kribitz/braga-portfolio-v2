---
// 01 · Work index — Site pattern 03 (Index): the section heading (its
// claim is this page's h1) and the listing of every non-draft project of
// the language by code. The UX pass (22 Oct 2026) dropped the year column
// (every row read "2026") and the status vocabulary block of Site s03: the
// label beside each square already says the state. The claim and the
// prose are i18n keys (the home Index shares them);
// the rows are the projects collection (src/lib/collections.ts). German
// strings are drafts: the DE page carries the in-build mark
// "Entwurf · Freigabe ausstehend" under the listing, as the tools index does.
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Listing from '@/components/Listing.astro';
import ListingRow from '@/components/ListingRow.astro';
import StatusMark from '@/components/StatusMark.astro';
import { t, type Lang } from '@/lib/i18n';
import { workRoute } from '@/lib/routes';
import { LANGS } from '@/lib/site';
import { projectsOf, LISTING_KEYWORDS } from '@/lib/collections';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const projects = await projectsOf(lang);
---
<Base lang={lang} page="work" title={t(lang, 'door.work')} description={t(lang, 'work.prose')} current="01">
  <section class="section">
    <SectionHeading number="01" word={t(lang, 'door.work')} claim={t(lang, 'work.claim')} prose={t(lang, 'work.prose')} as="h1" />
    {projects.length > 0 && (
      <Listing keys head={{ index: t(lang, 'index'), title: t(lang, 'project'), meta: t(lang, 'discipline-status'), keys: t(lang, 'stack'), trail: '' }}>
        {projects.map((p) => (
          <ListingRow code={p.data.code} title={p.data.title} sub={p.data.summary} meta={[p.data.domain]} status={p.data.status} keys={p.data.stack.slice(0, LISTING_KEYWORDS)} lang={lang} href={workRoute(p.data.slug, lang)} />
        ))}
      </Listing>
    )}
    {lang === 'de' && <div class="doc-meta"><StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} /></div>}
  </section>
</Base>
