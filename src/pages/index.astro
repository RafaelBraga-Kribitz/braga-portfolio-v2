---
// Root: the language chooser, a real page at "/" (BUILD-BRIEF §4). GitHub
// Pages cannot send an HTTP 301/302, and a meta refresh is what SEO tools
// flag, so the root does not redirect: it is the hreflang x-default page.
// It names the person and the role in running text (the h1's words appear
// in the body), links to both languages, is its own canonical, and its
// hreflang set includes itself (x-default → "/").
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { absolute, route } from '../lib/routes';
import { copyOf, fillIn } from '../lib/vault/copy.mjs';

const en = route('home', 'en');
const de = route('home', 'de');
const self = absolute('/');
// the page's words: website_vault/Site/en/Language chooser.md
const copy = copyOf('Language chooser', 'en');
const who = { name: site.name, role: site.role.en };
const description = fillIn(copy.seo_description, who);
const alternateLinks = [
  { hreflang: 'en', href: absolute(en) },
  { hreflang: 'de', href: absolute(de) },
  { hreflang: 'x-default', href: self },
];
---
<Base lang="en" page="home" title={site.role.en} description={description} canonicalUrl={self} alternateLinks={alternateLinks}>
  <article class="doc section">
    <h1>{site.name}</h1>
    <p>{fillIn(copy.text, who)}</p>
    <p><a href={en} hreflang="en">English <span class="glyph" aria-hidden="true">→</span></a> · <a href={de} hreflang="de" lang="de">Deutsch <span class="glyph" aria-hidden="true">→</span></a></p>
  </article>
</Base>
