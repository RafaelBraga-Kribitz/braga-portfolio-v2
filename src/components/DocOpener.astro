---
// Document opener, doc.css §3, Site specimen s04 and Templates 01–04:
// trail, title (with an optional large numeral beside it, the 404),
// lead, and the meta row. Two placements share one look:
//   grid    on the page grid (project pages, Site s04): trail on three
//           columns, title + lead + meta on nine;
//   stacked inside article.doc (utility pages, Templates): trail, title,
//           lead, meta in flow.
// DE pages pass `draft` to carry the in-build mark with the
// "Entwurf · Freigabe ausstehend" label first in the meta row until the
// owner approves (HANDOFF D-011, O-05).
import type { Lang, StatusState } from '../lib/i18n';
import { t } from '../lib/i18n';
import StatusMark from './StatusMark.astro';

interface Crumb {
  label: string;
  href?: string;
  /** The current item, set in ink. */
  current?: boolean;
  /** Glyph before this crumb; → by default, · for a qualifier. */
  sep?: '→' | '·';
}

type MetaItem =
  | { text: string; href?: string; external?: boolean }
  | { status: StatusState; label?: string };

interface Props {
  lang: Lang;
  trail: Crumb[];
  numeral?: string;
  title: string;
  lead?: string;
  meta?: MetaItem[];
  draft?: boolean;
  /** Trail on three columns, body on nine (Site s04). */
  grid?: boolean;
  /** A portrait under the trail on the three columns (the About page; owner,
      23 Oct 2026). Without `src` the frame shows empty, labelled, at the
      same 4:5 size, until src/assets/portrait.jpg exists. */
  portrait?: { src?: string; alt: string; caption: string; empty: string };
  /** Split placement (the About page; owner, 24 Oct 2026): `side` renders
      only the trail and the portrait, for the left column beside the
      article; `main` renders the stacked header without its trail, at the
      top of article.doc, so the body follows the lead whatever the
      portrait's height. */
  part?: 'side' | 'main';
  id?: string;
}

const { lang, trail, numeral, title, lead, meta = [], draft = false, grid = false, id, portrait, part } = Astro.props;
const hasMeta = meta.length > 0 || draft;
---
{part === 'side' ? (
  <Fragment>
    <p class="doc-trail">
      {trail.map((c, i) => (
        <Fragment>
          {i > 0 && <span class="glyph" aria-hidden="true">{c.sep ?? '→'}</span>}
          {c.href ? <a href={c.href}>{c.label}</a> : c.current ? <b>{c.label}</b> : <span>{c.label}</span>}
        </Fragment>
      ))}
    </p>
    {portrait && (
      <figure class="portrait">
        {portrait.src
          ? <img src={portrait.src} alt={portrait.alt} width="800" height="1000" decoding="async" />
          : <div class="portrait-empty"><span class="label">{portrait.empty}</span></div>}
        <figcaption class="label">{portrait.caption}</figcaption>
      </figure>
    )}
  </Fragment>
) : grid ? (
  <header class="doc-opener grid" id={id}>
    <div class="col-3">
      <p class="doc-trail">
        {trail.map((c, i) => (
          <Fragment>
            {i > 0 && <span class="glyph" aria-hidden="true">{c.sep ?? '→'}</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : c.current ? <b>{c.label}</b> : <span>{c.label}</span>}
          </Fragment>
        ))}
      </p>
      {portrait && (
        <figure class="portrait">
          {portrait.src
            ? <img src={portrait.src} alt={portrait.alt} width="800" height="1000" decoding="async" />
            : <div class="portrait-empty"><span class="label">{portrait.empty}</span></div>}
          <figcaption class="label">{portrait.caption}</figcaption>
        </figure>
      )}
    </div>
    <div class="col-9">
      {numeral ? (
        <div class="doc-numeral-row"><span class="doc-numeral" aria-hidden="true">{numeral}</span><h1>{title}</h1></div>
      ) : (
        <h1>{title}</h1>
      )}
      {lead && <p class="doc-lead">{lead}</p>}
      {hasMeta && (
        <div class="doc-meta">
          {draft && <StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} />}
          {meta.map((m) =>
            'status' in m ? (
              <StatusMark state={m.status} lang={lang} label={m.label} />
            ) : m.href ? (
              <a href={m.href}>{m.text}{m.external && <Fragment> <span class="glyph" aria-hidden="true">↗</span></Fragment>}</a>
            ) : (
              <span>{m.text}</span>
            ),
          )}
        </div>
      )}
    </div>
  </header>
) : (
  <header class="doc-opener" id={id}>
    {part !== 'main' && (
    <p class="doc-trail">
      {trail.map((c, i) => (
        <Fragment>
          {i > 0 && <span class="glyph" aria-hidden="true">{c.sep ?? '→'}</span>}
          {c.href ? <a href={c.href}>{c.label}</a> : c.current ? <b>{c.label}</b> : <span>{c.label}</span>}
        </Fragment>
      ))}
    </p>
    )}
    {numeral ? (
      <div class="doc-numeral-row"><span class="doc-numeral" aria-hidden="true">{numeral}</span><h1>{title}</h1></div>
    ) : (
      <h1>{title}</h1>
    )}
    {lead && <p class="doc-lead">{lead}</p>}
    {hasMeta && (
      <div class="doc-meta">
        {draft && <StatusMark state="in-build" lang={lang} label={t(lang, 'draft')} />}
        {meta.map((m) =>
          'status' in m ? (
            <StatusMark state={m.status} lang={lang} label={m.label} />
          ) : m.href ? (
            <a href={m.href}>{m.text}{m.external && <Fragment> <span class="glyph" aria-hidden="true">↗</span></Fragment>}</a>
          ) : (
            <span>{m.text}</span>
          ),
        )}
      </div>
    )}
  </header>
)}
