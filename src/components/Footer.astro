---
// Site footer, Site specimen s01: four link groups (D-013) over a
// wordmark bar. The bar's right block is the colophon: name / location ·
// EUR. The specimen's third line (status · year) was dropped by the owner,
// 24 Oct 2026. Casing is the stylesheet's (the colophon and
// labels are uppercased by CSS), so the source text keeps its natural case.
import { site } from '../lib/site';
import type { Lang } from '../lib/i18n';
import { footerGroups } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = footerGroups(lang);
// The colophon breaks only between phrases (owner, 24 Oct 2026): a name
// part, a place ending in a comma, or "Austria · EUR" stays on one line.
const phrases = (line: string) => line.replace(/ · /g, '\u00a0·\u00a0').split(/(?<=,) | (?=\S+$)/);
---
<footer class="grid-container">
  <div class="site-footer">
    <div class="grid">
      {groups.map((g) => (
        <nav class="col-3 site-footer-group" aria-label={g.title}>
          <p class="label">{g.title}</p>
          <ul class="site-footer-links">
            {g.links.map((l) => (
              <li><a href={l.href} hreflang={l.hreflang} lang={l.lang} data-keys-open={l.keys ? '' : undefined}>{l.label}{l.external && <Fragment> <span class="glyph" aria-hidden="true">↗</span></Fragment>}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="site-footer-bar">
      <span class="site-footer-mark">{site.wordmark.slice(0, 1)}<span class="wordmark-rest">{site.wordmark.slice(1)}</span></span>
      <p class="site-footer-colophon">{phrases(site.name).map((w, i) => <Fragment>{i > 0 && " "}<span>{w}</span></Fragment>)}<br>{phrases(`${site.location[lang]} · EUR`).map((w, i) => <Fragment>{i > 0 && " "}<span>{w}</span></Fragment>)}</p>
    </div>
  </div>
</footer>
