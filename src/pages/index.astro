---
// Root: a static redirect page to /en/ (BUILD-BRIEF §4). A meta refresh
// of 0 does the work, the canonical names /en/, and a plain pair of links
// serves a browser that does not follow the refresh. It still carries what
// every page carries (skip link, one main, one h1, the two theme-color
// metas, the hreflang pair, and the pre-paint script, the one script it
// has: a reader with a stored dark choice sees no light frame before
// /en/), so it reads as part of the site for the moment it is seen.
import '../styles/global.css';
import { site } from '../lib/site';
import { absolute, alternates, route, withBase } from '../lib/routes';
import { themeColor, PREPAINT } from '../lib/theme';

const en = route('home', 'en');
const de = route('home', 'de');
// The bare address is the one people paste into a post, and LinkedIn does
// not follow a meta refresh: the stub carries the share tags of the home
// page itself (same card as Base.astro), pointed at /en/.
const description = 'Portfolio of Rafael Braga-Kribitz, Marketing Data Analyst. English and German.';
const shareTitle = `${site.role.en} · ${site.name}`;
const shareCard = absolute('/share-card.png');
const shareAlt = `${site.wordmark} · ${site.name} · ${site.role.en}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light}>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark}>
    <script is:inline set:html={PREPAINT}></script>
    <meta http-equiv="refresh" content={`0; url=${en}`}>
    <title>{site.name}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={absolute(en)}>
    {alternates('home').map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')}>
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/favicon-180.png')}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={shareTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={absolute(en)}>
    <meta property="og:image" content={shareCard}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={shareAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={shareTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={shareCard}>
    <meta name="twitter:image:alt" content={shareAlt}>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <main id="main" class="grid-container">
      <article class="doc section">
        <h1>{site.name}</h1>
        <p><a href={en} hreflang="en">English <span class="glyph" aria-hidden="true">→</span></a> · <a href={de} hreflang="de" lang="de">Deutsch <span class="glyph" aria-hidden="true">→</span></a></p>
      </article>
    </main>
  </body>
</html>
